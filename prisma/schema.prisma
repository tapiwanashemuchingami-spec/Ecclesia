// ============================================================================
// MEMBERSHIP LIFECYCLE
// ============================================================================

model MembershipStatusChange {
  id            String    @id @default(cuid())
  churchId      String
  
  memberId      String
  previousStatus String
  requestedStatus String
  
  changeType    String    // MARRIAGE, DEATH, TRANSFER, REJOINING, etc.
  reason        String?   @db.Text
  
  requestedAt   DateTime  @default(now())
  requestedBy   String    // Member ID (statistician)
  
  status        String    @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedAt    DateTime?
  approvedBy    String?   // Member ID (pastor)
  approvalReason String?
  
  effectiveDate DateTime?
  
  createdAt     DateTime  @default(now())
  
  @@index([churchId])
  @@index([memberId])
  @@index([status])
}

model StatusChangeApproval {
  id            String    @id @default(cuid())
  changeId      String    @unique
  
  approvedBy    String    // Member ID
  approvedAt    DateTime  @default(now())
  
  reason        String?   @db.Text
  effectiveDate DateTime?
  
  createdAt     DateTime  @default(now())
}

// ============================================================================
// AUDIT LOG
// ============================================================================

model AuditLog {
  id            String    @id @default(cuid())
  churchId      String
  church        Church    @relation(fields: [churchId], references: [id], onDelete: Cascade)
  
  action        String    // MEMBER_CREATED, STATUS_CHANGED, CASE_OPENED, VISIT_RECORDED, etc.
  entityType    String    // MEMBER, CASE, VISIT, COUNSELING, etc.
  entityId      String
  
  actorId       String    // Member ID who performed action
  
  previousState String?   @db.Text // JSON
  newState      String?   @db.Text // JSON
  
  reason        String?
  reference     String?   // External reference (e.g., approval ID)
  
  timestamp     DateTime  @default(now())
  
  createdAt     DateTime  @default(now())
  
  @@index([churchId])
  @@index([action])
  @@index([entityType])
  @@index([entityId])
  @@index([timestamp])
}

// ============================================================================
// ORGANIZATION FINANCE
// ============================================================================

model OrganizationFinancialAccount {
  id            String    @id @default(cuid())
  organizationId String   @unique
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  balance       Decimal   @default(0)
  status        String    @default("ACTIVE")
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}
