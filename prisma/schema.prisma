// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// IDENTITY & AUTHENTICATION
// ============================================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  
  memberId      String?   @unique
  member        Member?   @relation("UserMember", fields: [memberId], references: [id])
  
  sessions      Session[]
  devices       Device[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  @@index([email])
}

model Session {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  token         String    @unique
  refreshToken  String?   @unique
  expiresAt     DateTime
  
  createdAt     DateTime  @default(now())
  
  @@index([userId])
}

model Device {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  userAgent     String?
  ipAddress     String?
  lastSeenAt    DateTime  @default(now())
  
  createdAt     DateTime  @default(now())
  
  @@index([userId])
}

// ============================================================================
// ORGANIZATION STRUCTURE
// ============================================================================

model Circuit {
  id            String    @id @default(cuid())
  name          String
  churches      Church[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Church {
  id            String    @id @default(cuid())
  circuitId     String?
  circuit       Circuit?  @relation(fields: [circuitId], references: [id])
  
  name          String
  location      String?
  
  // Organization hierarchy
  sections      Section[]
  families      Family[]
  members       Member[]
  organizations Organization[]
  committees    Committee[]
  
  // Events
  events        Event[]
  
  // Finance
  financialAccount FinancialAccount?
  funds         Fund[]
  receipts      Receipt[]
  expenditures  Expenditure[]
  cashSessions  CashSession[]
  
  // Leadership
  roles         Role[]
  leadershipAssignments LeadershipAssignment[]
  
  // Pastoral
  pastoralCases PastoralCase[]
  pastoralVisits PastoralVisit[]
  counselingSessions CounselingSession[]
  pastoralReferrals PastoralReferral[]
  pastoralFollowUps PastoralFollowUp[]
  pastoralAssessments PastoralAssessment[]
  prayerRequests PrayerRequest[]
  lifeEvents    LifeEvent[]
  spiritualDevelopmentRecords SpiritualDevelopmentRecord[]
  baptismRecords BaptismRecord[]
  confirmationRecords ConfirmationRecord[]
  marriageRecords MarriageRecord[]
  funeralRecords FuneralRecord[]
  pastoralNotifications PastoralNotification[]
  
  // Audit
  auditLogs     AuditLog[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  @@index([circuitId])
}

model Section {
  id            String    @id @default(cuid())
  churchId      String
  church        Church    @relation(fields: [churchId], references: [id], onDelete: Cascade)
  
  name          String
  description   String?
  
  members       Member[]
  families      Family[]
  events        Event[]
  
  // Section Finance (isolated)
  financialAccount SectionFinancialAccount?
  receipts      SectionReceipt[]
  expenditures  SectionExpenditure[]
  transactions  SectionTransaction[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  @@index([churchId])
  @@unique([churchId, name])
}

model Family {
  id            String    @id @default(cuid())
  churchId      String
  church        Church    @relation(fields: [churchId], references: [id], onDelete: Cascade)
  
  sectionId     String?
  section       Section?  @relation(fields: [sectionId], references: [id])
  
  name          String
  description   String?
  
  members       Member[]
  relationships FamilyRelationship[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  @@index([churchId])
  @@index([sectionId])
}

model Member {
  id            String    @id @default(cuid())
  churchId      String
  church        Church    @relation(fields: [churchId], references: [id], onDelete: Cascade)
  
  sectionId     String?
  section       Section?  @relation(fields: [sectionId], references: [id])
  
  familyId      String?
  family        Family?   @relation(fields: [familyId], references: [id])
  
  // Identity
  firstName     String
  lastName      String
  email         String?
  phone         String?
  gender        String?
  dateOfBirth   DateTime?
  
  // Membership
  membershipNumber String @unique
  membershipStatus String  @default("ACTIVE") // ACTIVE, INACTIVE, TRANSFERRED, DECEASED
  joinDate      DateTime  @default(now())
  
  // Family relationships
  isDependent   Boolean   @default(false)
  parentId      String?
  parent        Member?   @relation("DependentRelationships", fields: [parentId], references: [id])
  dependents    Member[]  @relation("DependentRelationships")
  
  // Personal info
  maritalStatus String?   // SINGLE, MARRIED, DIVORCED, WIDOWED
  
  // Authentication
  user          User?     @relation("UserMember")
  
  // Leadership & Permissions
  leadershipAssignments LeadershipAssignment[]
  organizationRoles OrganizationRoleAssignment[]
  
  // Family relationships
  asPartner1    FamilyRelationship[] @relation("Partner1")
  asPartner2    FamilyRelationship[] @relation("Partner2")
  asParent      FamilyRelationship[] @relation("Parent")
  asChild       FamilyRelationship[] @relation("Child")
  
  // Organization membership
  organizationMemberships OrganizationMembership[]
  
  // Events & Attendance
  eventAttendances EventAttendance[]
  
  // Finance
  receipts      Receipt[]
  expenditures  Expenditure[]
  
  // Section Finance
  sectionReceipts SectionReceipt[]
  
  // Pastoral Care
  pastoralCases PastoralCase[]        @relation("PastoralCaseMember")
  assignedCases PastoralCase[]        @relation("PastoralCaseAssignedPastor")
  pastoralVisits PastoralVisit[]
  counselingSessions CounselingSession[]
  pastoralReferrals PastoralReferral[]
  pastoralFollowUps PastoralFollowUp[]
  pastoralAssessments PastoralAssessment[]
  prayerRequests PrayerRequest[]
  lifeEvents    LifeEvent[]
  spiritualDevelopmentRecords SpiritualDevelopmentRecord[]
  baptismRecords BaptismRecord[]
  confirmationRecords ConfirmationRecord[]
  marriageRecordsP1 MarriageRecord[]   @relation("MarriageRecordPartner1")
  marriageRecordsP2 MarriageRecord[]   @relation("MarriageRecordPartner2")
  funeralRecords FuneralRecord[]
  
  // Audit
  lastPastoralContactAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  @@index([churchId])
  @@index([sectionId])
  @@index([familyId])
  @@index([membershipStatus])
  @@unique([churchId, email])
}

model FamilyRelationship {
  id            String    @id @default(cuid())
  
  partner1Id    String?
  partner1      Member?   @relation("Partner1", fields: [partner1Id], references: [id])
  
  partner2Id    String?
  partner2      Member?   @relation("Partner2", fields: [partner2Id], references: [id])
  
  parentId      String?
  parent        Member?   @relation("Parent", fields: [parentId], references: [id])
  
  childId       String?
  child         Member?   @relation("Child", fields: [childId], references: [id])
  
  relationshipType String  // SPOUSE, CHILD, PARENT, SIBLING
  
  createdAt     DateTime  @default(now())
}

// ============================================================================
// ORGANIZATIONS (Fellowships, Groups)
// ============================================================================

model Organization {
  id            String    @id @default(cuid())
  churchId      String
  church        Church    @relation(fields: [churchId], references: [id], onDelete: Cascade)
  
  name          String    // MUMC, RRW, UMYF, Children's Ministries, etc.
  description   String?
  
  members       OrganizationMembership[]
  roles         OrganizationRoleAssignment[]
  events        Event[]
  financialAccount OrganizationFinancialAccount?
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  @@index([churchId])
  @@unique([churchId, name])
}

model OrganizationMembership {
  id            String    @id @default(cuid())
  organizationId String
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  memberId      String
  member        Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  
  joinedAt      DateTime  @default(now())
  membershipStatus String  @default("ACTIVE") // ACTIVE, INACTIVE, TRANSFERRED
  
  @@unique([organizationId, memberId])
  @@index([organizationId])
  @@index([memberId])
}

model OrganizationRoleAssignment {
  id            String    @id @default(cuid())
  organizationId String
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  memberId      String
  member        Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  
  position      String    // President, Treasurer, Secretary, etc.
  startDate     DateTime  @default(now())
  endDate       DateTime?
  
  createdAt     DateTime  @default(now())
  
  @@unique([organizationId, memberId, position])
  @@index([organizationId])
  @@index([memberId])
}

model Committee {
  id            String    @id @default(cuid())
  churchId      String
  church        Church    @relation(fields: [churchId], references: [id], onDelete: Cascade)
  
  name          String
  description   String?
  
  members       LeadershipAssignment[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  @@index([churchId])
}

// ============================================================================
// LEADERSHIP & PERMISSIONS
// ============================================================================

model Role {
  id            String    @id @default(cuid())
  churchId      String
  church        Church    @relation(fields: [churchId], references: [id], onDelete: Cascade)
  
  name          String    // Pastor, Treasurer, Section Leader, etc.
  description   String?
  
  permissions   RolePermission[]
  assignments   LeadershipAssignment[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  @@unique([churchId, name])
  @@index([churchId])
}

model Permission {
  id            String    @id @default(cuid())
  
  name          String    @unique // member:view, pastoral:case:create, etc.
  description   String?
  
  rolePermissions RolePermission[]
  
  createdAt     DateTime  @default(now())
}

model RolePermission {
  id            String    @id @default(cuid())
  roleId        String
  role          Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  
  permissionId  String
  permission    Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  
  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model LeadershipAssignment {
  id            String    @id @default(cuid())
  churchId      String
  church        Church    @relation(fields: [churchId], references: [id], onDelete: Cascade)
  
  memberId      String
  member        Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  
  roleId        String
  role          Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  
  committeeId   String?
  committee     Committee? @relation(fields: [committeeId], references: [id])
  
  position      String?   // Specific title within role
  startDate     DateTime  @default(now())
  endDate       DateTime?
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  @@index([churchId])
  @@index([memberId])
  @@index([roleId])
  @@index([committeeId])
}

// ============================================================================
// EVENTS & ATTENDANCE
// ============================================================================

model Event {
  id            String    @id @default(cuid())
  churchId      String
  church        Church    @relation(fields: [churchId], references: [id], onDelete: Cascade)
  
  sectionId     String?
  section       Section?  @relation(fields: [sectionId], references: [id])
  
  organizationId String?
  organization  Organization? @relation(fields: [organizationId], references: [id])
  
  title         String
  description   String?
  
  eventType     String    // SERVICE, BIBLE_STUDY, PRAYER, WEDDING, BAPTISM, FUNERAL, etc.
  
  startDateTime DateTime
  endDateTime   DateTime?
  location      String?
  
  status        String    @default("SCHEDULED") // SCHEDULED, ONGOING, COMPLETED, CANCELLED
  expectedAttendance Int?
  
  attendances   EventAttendance[]
  participants  EventParticipant[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  @@index([churchId])
  @@index([sectionId])
  @@index([organizationId])
  @@index([startDateTime])
}

model EventAttendance {
  id            String    @id @default(cuid())
  eventId       String
  event         Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  memberId      String
  member        Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  
  status        String    // PRESENT, ABSENT, EXCUSED, UNCONFIRMED
  arrivedAt     DateTime?
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  @@unique([eventId, memberId])
  @@index([eventId])
  @@index([memberId])
}

model EventParticipant {
  id            String    @id @default(cuid())
  eventId       String
  event         Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  memberId      String
  member        Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  
  role          String?   // Preacher, Usher, Musician, etc.
  
  @@unique([eventId, memberId])
  @@index([eventId])
}

// ============================================================================
// FINANCE - MAIN CHURCH LEDGER
// ============================================================================

model FinancialAccount {
  id            String    @id @default(cuid())
  churchId      String    @unique
  church        Church    @relation(fields: [churchId], references: [id], onDelete: Cascade)
  
  openingBalance Decimal   @default(0)
  currentBalance Decimal   @default(0)
  status        String    @default("ACTIVE") // ACTIVE, INACTIVE
  
  funds         Fund[]
  receipts      Receipt[]
  expenditures  Expenditure[]
  cashSessions  CashSession[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Fund {
  id            String    @id @default(cuid())
  churchId      String
  church        Church    @relation(fields: [churchId], references: [id], onDelete: Cascade)
  
  accountId     String
  account       FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  
  name          String    // Building Fund, Missions, General, etc.
  description   String?
  balance       Decimal   @default(0)
  
  receipts      Receipt[]
  expenditures  Expenditure[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  @@unique([churchId, name])
  @@index([churchId])
  @@index([accountId])
}

model Receipt {
  id            String    @id @default(cuid())
  churchId      String
  church        Church    @relation(fields: [churchId], references: [id], onDelete: Cascade)
  
  fundId        String
  fund          Fund      @relation(fields: [fundId], references: [id], onDelete: Restrict)
  
  memberId      String?
  member        Member?   @relation(fields: [memberId], references: [id])
  
  amount        Decimal
  currency      String    @default("USD")
  incomeType    String    // OFFERING, TITHE, DONATION, FUNDRAISING
  paymentMethod String    // CASH, BANK_TRANSFER, MOBILE_MONEY, CHEQUE
  
  receiptNumber String    @unique
  status        String    @default("ISSUED") // ISSUED, VOIDED, REVERSED
  
  recordedAt    DateTime  @default(now())
  recordedBy    String?   // Member ID of recorder
  
  createdAt     DateTime  @default(now())
  
  @@index([churchId])
  @@index([fundId])
  @@index([memberId])
}

model Expenditure {
  id            String    @id @default(cuid())
  churchId      String
  church        Church    @relation(fields: [churchId], references: [id], onDelete: Cascade)
  
  fundId        String
  fund          Fund      @relation(fields: [fundId], references: [id], onDelete: Restrict)
  
  requestedBy   String
  requestedByMember Member? @relation(fields: [requestedBy], references: [id])
  
  amount        Decimal
  purpose       String
  category      String    // Administrative, Building, Salaries, etc.
  
  status        String    @default("DRAFT") // DRAFT, SUBMITTED, APPROVED, REJECTED, PAID
  approvedBy    String?
  approvedAt    DateTime?
  
  paidAt        DateTime?
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  @@index([churchId])
  @@index([fundId])
}

model CashSession {
  id            String    @id @default(cuid())
  churchId      String
  church        Church    @relation(fields: [churchId], references: [id], onDelete: Cascade)
  
  accountId     String
  account       FinancialAccount @relation(fields: [accountId], references: [id])
  
  openingBalance Decimal
  closingBalance Decimal
  
  handledBy     String    // Member ID
  sessionDate   DateTime  @default(now())
  
  createdAt     DateTime  @default(now())
  
  @@index([churchId])
  @@index([accountId])
}

// ============================================================================
// FINANCE - SECTION LEDGER (ISOLATED)
// ============================================================================

model SectionFinancialAccount {
  id            String    @id @default(cuid())
  sectionId     String    @unique
  section       Section   @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  
  openingBalance Decimal   @default(0)
  currentBalance Decimal   @default(0)
  status        String    @default("ACTIVE")
  
  receipts      SectionReceipt[]
  expenditures  SectionExpenditure[]
  transactions  SectionTransaction[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model SectionReceipt {
  id            String    @id @default(cuid())
  sectionId     String
  section       Section   @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  
  accountId     String
  account       SectionFinancialAccount @relation(fields: [accountId], references: [id])
  
  memberId      String?
  member        Member?   @relation(fields: [memberId], references: [id])
  
  amount        Decimal
  incomeType    String
  paymentMethod String
  status        String    @default("ISSUED")
  
  recordedAt    DateTime  @default(now())
  
  @@index([sectionId])
  @@index([accountId])
}

model SectionExpenditure {
  id            String    @id @default(cuid())
  sectionId     String
  section       Section   @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  
  accountId     String
  account       SectionFinancialAccount @relation(fields: [accountId], references: [id])
  
  amount        Decimal
  purpose       String
  status        String    @default("DRAFT")
  approvedAt    DateTime?
  
  createdAt     DateTime  @default(now())
  
  @@index([sectionId])
  @@index([accountId])
}

model SectionTransaction {
  id            String    @id @default(cuid())
  sectionId     String
  section       Section   @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  
  accountId     String
  account       SectionFinancialAccount @relation(fields: [accountId], references: [id])
  
  debitAmount   Decimal   @default(0)
  creditAmount  Decimal   @default(0)
  reference     String?
  
  postedAt      DateTime  @default(now())
  
  @@index([sectionId])
  @@index([accountId])
}

// ============================================================================
// PASTORAL CARE SYSTEM
// ============================================================================

model PastoralCase {
  id            String    @id @default(cuid())
  churchId      String
  church        Church    @relation(fields: [churchId], references: [id], onDelete: Cascade)
  
  memberId      String
  member        Member    @relation("PastoralCaseMember", fields: [memberId], references: [id], onDelete: Cascade)
  
  category      String    // SPIRITUAL, FAMILY, MARRIAGE, BEREAVEMENT, EMOTIONAL, FINANCIAL, etc.
  concern       String    @db.Text
  priority      String    @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  status        String    @default("OPEN") // OPEN, IN_PROGRESS, WAITING_FOLLOW_UP, REFERRED, RESOLVED, CLOSED
  
  assignedPastorId String?
  assignedPastor Member?  @relation("PastoralCaseAssignedPastor", fields: [assignedPastorId], references: [id])
  
  openedAt      DateTime  @default(now())
  openedBy      String    // Member ID of pastor
  
  targetFollowUpAt DateTime?
  resolvedAt    DateTime?
  resolvedReason String?
  closedAt      DateTime?
  
  // Relationships
  activities    PastoralCaseActivity[]
  visits        PastoralVisit[]       @relation("CaseVisits")
  counselingSessions CounselingSession[] @relation("CaseCounseling")
  referrals     PastoralReferral[]
  followUps     PastoralFollowUp[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  @@index([churchId])
  @@index([memberId])
  @@index([status])
  @@index([priority])
}

model PastoralCaseActivity {
  id            String    @id @default(cuid())
  caseId        String
  case          PastoralCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  
  activityType  String    // VISIT, COUNSELING, PRAYER, PHONE_CALL, MESSAGE, REFERRAL, ASSISTANCE, FAMILY_INTERVENTION, FOLLOW_UP, ASSESSMENT, NOTE
  
  description   String    @db.Text
  notes         String?   @db.Text
  actorId       String    // Member ID of actor
  
  occurredAt    DateTime  @default(now())
  createdAt     DateTime  @default(now())
  
  @@index([caseId])
  @@index([activityType])
}

model PastoralVisit {
  id            String    @id @default(cuid())
  churchId      String
  church        Church    @relation(fields: [churchId], references: [id], onDelete: Cascade)
  
  memberId      String
  member        Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  
  caseId        String?
  case          PastoralCase? @relation("CaseVisits", fields: [caseId], references: [id])
  
  visitType     String    // GENERAL_PASTORAL, SICKNESS, HOSPITAL, BEREAVEMENT, FAMILY, MARRIAGE, NEW_MEMBER, INACTIVE_MEMBER, ELDERLY, BIRTH, CELEBRATION, FINANCIAL_SUPPORT, SPIRITUAL_SUPPORT, CRISIS, FOLLOW_UP, OTHER
  
  visitedBy     String    // Member ID of pastor
  visitDate     DateTime
  location      String?
  
  purpose       String    @db.Text
  observations  String    @db.Text
  outcome       String    // NO_FURTHER_ACTION, FOLLOW_UP_REQUIRED, COUNSELING_REQUIRED, FINANCIAL_ASSISTANCE, FAMILY_INTERVENTION, REFERRAL, PRAYER_SUPPORT
  
  followUpRequired Boolean  @default(false)
  followUpDate  DateTime?
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  @@index([churchId])
  @@index([memberId])
  @@index([visitDate])
  @@index([caseId])
}

model CounselingSession {
  id            String    @id @default(cuid())
  churchId      String
  church        Church    @relation(fields: [churchId], references: [id], onDelete: Cascade)
  
  memberId      String
  member        Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  
  caseId        String?
  case          PastoralCase? @relation("CaseCounseling", fields: [caseId], references: [id])
  
  counselorId   String    // Member ID
  counselingType String   // SPIRITUAL, PRE_MARITAL, MARRIAGE, FAMILY, GRIEF, EMOTIONAL_SUPPORT, FINANCIAL, CAREER, YOUTH, CHILD, PARENTING, LIFE_DECISION, CRISIS, ADDICTION_SUPPORT, BEREAVEMENT, OTHER
  
  concern       String    @db.Text
  intervention  String?   @db.Text
  outcome       String    // RESOLVED, FOLLOW_UP_REQUIRED, ONGOING, REFERRED, ESCALATED
  
  sessionDate   DateTime
  
  // Confidential - requires pastoral:counseling:confidential permission
  confidentialNotes String? @db.Text
  followUpPlan  String?   @db.Text
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  @@index([churchId])
  @@index([memberId])
  @@index([counselorId])
  @@index([caseId])
}

model PastoralReferral {
  id            String    @id @default(cuid())
  churchId      String
  church        Church    @relation(fields: [churchId], references: [id], onDelete: Cascade)
  
  memberId      String
  member        Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  
  caseId        String
  case          PastoralCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  
  referralType  String    // PROFESSIONAL_COUNSELING, MEDICAL, FINANCIAL_SUPPORT, EMPLOYMENT, LEGAL_SUPPORT, FAMILY_SUPPORT, COMMUNITY_ASSISTANCE, OTHER
  
  referredBy    String    // Member ID
  providerName  String
  reason        String    @db.Text
  
  referralDate  DateTime  @default(now())
  status        String    @default("PENDING") // PENDING, ACCEPTED, IN_PROGRESS, COMPLETED, DECLINED, AWAITING_RESPONSE
  followUpDate  DateTime?
  
  outcome       String?   @db.Text
  notes         String?   @db.Text
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  @@index([churchId])
  @@index([memberId])
  @@index([caseId])
  @@index([status])
}

model PastoralFollowUp {
  id            String    @id @default(cuid())
  churchId      String
  church        Church    @relation(fields: [churchId], references: [id], onDelete: Cascade)
  
  memberId      String
  member        Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  
  caseId        String
  case          PastoralCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  
  dueDate       DateTime
  completedAt   DateTime?
  
  reason        String    @db.Text
  notes         String?   @db.Text
  
  status        String    @default("PENDING") // PENDING, COMPLETED, CANCELLED, OVERDUE
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  @@index([churchId])
  @@index([memberId])
  @@index([dueDate])
  @@index([status])
}

model PastoralAssessment {
  id            String    @id @default(cuid())
  churchId      String
  church        Church    @relation(fields: [churchId], references: [id], onDelete: Cascade)
  
  memberId      String
  member        Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  
  // Wellbeing dimensions
  spiritual     String    // HEALTHY, STABLE, DISENGAGED, NEEDS_DISCIPLESHIP, FAITH_CRISIS, GROWING, LEADERSHIP_DEVELOPMENT
  social        String    // HEALTHY, FAMILY_CONFLICT, MARRIAGE_DIFFICULTY, BEREAVEMENT, SOCIAL_ISOLATION, PARENTING_CONCERN, FAMILY_TRANSITION
  emotional     String    // NORMAL, GRIEF, STRESS, LONELINESS, CRISIS, EMOTIONAL_SUPPORT_NEEDED, RELATIONSHIP_DIFFICULTY, LIFE_TRANSITION
  economic      String    // SECURE, EMPLOYMENT_DIFFICULTY, UNEMPLOYED, BUSINESS_DIFFICULTY, FOOD_INSECURITY, SCHOOL_FEE_DIFFICULTY, HOUSING_DIFFICULTY, DEBT
  physical      String    // NORMAL, HOSPITALIZED, HOMEBOUND, ELDERLY_CARE_NEEDED, DISABILITY_SUPPORT, RECOVERY, TRANSPORTATION_NEED, PRACTICAL_ASSISTANCE
  
  notes         String?   @db.Text
  
  assessedAt    DateTime  @default(now())
  assessedBy    String    // Member ID
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  @@index([churchId])
  @@index([memberId])
}

model PrayerRequest {
  id            String    @id @default(cuid())
