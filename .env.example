# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ecclesia_dev

# Server
NODE_ENV=development
PORT=3000
API_VERSION=v1

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRY=24h
REFRESH_TOKEN_EXPIRY=7d

# Security
BCRYPT_ROUNDS=10
CORS_ORIGIN=http://localhost:3001,http://localhost:8080

# Logging
LOG_LEVEL=info

# App
APP_NAME=Ecclesia
APP_VERSION=2.0.0
